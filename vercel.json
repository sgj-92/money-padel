{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/stamp-build.js",
  "redirects": [
    {
      "source": "/((?!assets/|api/|review(?:/|$)|poll(?:/|$)).+)",
      "has": [
        {
          "type": "host",
          "value": "mpstandings.sgj.luxe"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/((?!assets/|api/|review(?:/|$)|poll(?:/|$)).+)",
      "has": [
        {
          "type": "host",
          "value": "pcstandings.sgj.luxe"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/preview",
      "destination": "/preview/",
      "permanent": false
    },
    {
      "source": "/review",
      "destination": "/review/",
      "permanent": false
    },
    {
      "source": "/poll",
      "destination": "/poll/",
      "permanent": false
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 120
    }
  }
}
